# ==============================================================================
# PKampus - Production environment template (Oracle A1 + Supabase + Resend)
# ==============================================================================
# Install on the VM as /etc/pkampus/.env (chmod 600). NEVER commit the real
# file — .gitignore already excludes .env*. Compose loads it via:
#   docker compose -f docker-compose.prod.yml --env-file /etc/pkampus/.env up -d
# Generate fresh secrets (do NOT reuse dev values from .env.example):
#   openssl rand -base64 48   # JWT_SECRET / EMAIL_TOKEN_SECRET / MINIO passwords
# ==============================================================================

# --- Edge (Caddy + own domain, e.g. pkampus.me from GitHub Student Pack) ---
DOMAIN=api.pkampus.me

# --- Database (Supabase Postgres, SSL required) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
#
# PREFERRED: "Direct connection" (db.<ref>.supabase.co:5432).
# WARNING: the direct hostname resolves to IPv6 ONLY. If your network (or the
# Oracle VCN, which has no IPv6 by default) has no IPv6 route, JDBC fails with
# "Network is unreachable" / "Sieć jest niedostępna". In that case use the
# FALLBACK below instead — no code changes needed, URL is env-driven.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.CHANGEME.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.CHANGEME
SPRING_DATASOURCE_PASSWORD=CHANGEME-supabase-db-password
#
# FALLBACK (no IPv6 route): "Session pooler" (port 5432, IPv4-capable).
# Dashboard -> Connect -> Session mode. Session mode pins one server
# connection per client, so Flyway DDL (V1..V12 incl. EXCLUDE USING gist)
# and Hikari prepared statements both work. Do NOT use Transaction mode
# (port 6543) — it breaks DDL/prepared statements.
#SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
#SPRING_DATASOURCE_USERNAME=postgres.CHANGEME
#SPRING_DATASOURCE_PASSWORD=CHANGEME-supabase-db-password

# --- Object storage (MinIO on this VM, private buckets, NFR-SEC-03) ---
# Backend reaches MinIO via http://pkampus-minio:9000 inside pkampus-net
# (MINIO_ENDPOINT is forced in docker-compose.prod.yml). Below are only creds.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGEME-minio-root-min-32-chars
MINIO_APP_USER=pkampus_app
MINIO_APP_PASSWORD=CHANGEME-minio-app-min-32-chars
MINIO_BUCKET_ISSUES=pkampus-issues
MINIO_BUCKET_AVATARS=pkampus-avatars

# --- Mail (free SMTP, port 587 + STARTTLS) ---
# Option A — Resend (100/day, 3000/month). Requires a domain you own (free
# public domains like duckdns.org are rejected); verify it in the Resend
# Domains panel first. SMTP user is literally "resend".
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_CHANGEME-resend-api-key
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# FROM must be a sender/domain verified in the provider panel.
# Independent from the SMTP username above.
APP_MAIL_FROM=noreply@pkampus.me
#
# Option B — Brevo (300/day, no card). Works WITHOUT own domain: verify a
# single sender email (Settings -> Senders -> Add sender, code from inbox).
# SMTP login is your Brevo account email, password is a generated SMTP key
# (SMTP page -> Generate a new SMTP key, NOT an API key), ports 587/2525/465.
#SPRING_MAIL_HOST=smtp-relay.brevo.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=CHANGEME-brevo-login-email
#SPRING_MAIL_PASSWORD=CHANGEME-brevo-smtp-key
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
#APP_MAIL_FROM=CHANGEME-verified-sender-email
#
# Option C — dedicated Gmail mailbox + App Password (500/day, no card).
# No private address involved: create e.g. pkampus.noreply@gmail.com, enable
# 2-Step Verification, then generate an App Password (Google Account ->
# Security -> App passwords, 16 letters). Best Gmail->Gmail deliverability,
# but Google may challenge the first login from the Oracle IP — test early.
#SPRING_MAIL_HOST=smtp.gmail.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=pkampus.noreply.CHANGEME@gmail.com
#SPRING_MAIL_PASSWORD=CHANGEME-16-letter-app-password-no-spaces
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
#APP_MAIL_FROM=pkampus.noreply.CHANGEME@gmail.com

# --- Frontend (Vercel) + CORS ---
# Vercel project domain, e.g. https://pkampus-demo.vercel.app (no trailing /).
# Both must match exactly or browsers block API calls (SecurityConfig CORS).
FRONTEND_URL=https://CHANGEME.vercel.app
CORS_ALLOWED_ORIGINS=https://CHANGEME.vercel.app

# --- Auth secrets (generate fresh, min 32 chars) ---
JWT_SECRET=CHANGEME-jwt-min-32-chars-generate-with-openssl
EMAIL_TOKEN_SECRET=CHANGEME-email-token-min-32-chars-generate-with-openssl
MAX_ACTIVE_REFRESH_TOKENS=5
TRUST_FORWARDED_HEADERS=true

# --- Optional image override (default: local build from backend/Dockerfile) ---
# BACKEND_IMAGE=pkampus-backend:latest
