# ==============================================================================
# PKampus - Środowisko uruchomieniowe lokalne (Environment Variables)
# ==============================================================================
# Skopiuj ten plik do .env i dostosuj wartości do swojego środowiska:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Relacyjna Baza Danych (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=pkampus_db
DB_USER=pkampus_user
DB_PASSWORD=pkampus_dev_password_change_in_prod_123!
# Mapowanie portu na localhost (127.0.0.1) na potrzeby lokalnego developmentu (IDE / DBeaver)
DB_PORT_BINDING=127.0.0.1:5432:5432

# ------------------------------------------------------------------------------
# 2. Magazyn Obiektowy S3 (MinIO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_secret_dev_123!

MINIO_APP_USER=pkampus_app
MINIO_APP_PASSWORD=pkampus_minio_app_secret_dev_123!

MINIO_BUCKET_ISSUES=pkampus-issues
MINIO_BUCKET_AVATARS=pkampus-avatars

# Porty MinIO (API: 9000, Console: 9001) - bindowane do localhost dla bezpieczeństwa
MINIO_PORT_BINDING=127.0.0.1:9000:9000
MINIO_CONSOLE_BINDING=127.0.0.1:9001:9001

# ------------------------------------------------------------------------------
# 3. Serwis Pocztowy (SMTP / Mailpit)
# ------------------------------------------------------------------------------
# Port panelu Web UI Mailpit (inspekcja wiadomości e-mail w przeglądarce)
MAILPIT_WEB_BINDING=127.0.0.1:8025:8025
# Port serwera SMTP dla aplikacji uruchamianej lokalnie w IDE
MAIL_PORT_BINDING=127.0.0.1:1025:1025

# ------------------------------------------------------------------------------
# 4. Bezpieczeństwo i Uwierzytelnianie (Spring Security / JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=pkampus_jwt_super_secret_key_development_min_32_characters_long_2026!

# ------------------------------------------------------------------------------
# 5. Reverse Proxy / Frontend
# ------------------------------------------------------------------------------
PROXY_PORT_BINDING=80:80

# ------------------------------------------------------------------------------
# 6. Kopie Zapasowe (Backup AES-256 GPG)
# ------------------------------------------------------------------------------
BACKUP_PASSPHRASE=pkampus_backup_passphrase_dev_change_in_production_2026!
