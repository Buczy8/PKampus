# ==============================================================================
# PKampus - Local Development Environment Variables
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Relational Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=pkampus_db
DB_USER=pkampus_user
DB_PASSWORD=pkampus_dev_password_change_in_prod_123!
DB_PORT_BINDING=127.0.0.1:5432:5432

# ------------------------------------------------------------------------------
# 2. Object Storage S3 (MinIO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_secret_dev_123!

MINIO_APP_USER=pkampus_app
MINIO_APP_PASSWORD=pkampus_minio_app_secret_dev_123!

MINIO_BUCKET_ISSUES=pkampus-issues
MINIO_BUCKET_AVATARS=pkampus-avatars

MINIO_PORT_BINDING=127.0.0.1:9000:9000
MINIO_CONSOLE_BINDING=127.0.0.1:9001:9001

# ------------------------------------------------------------------------------
# 3. Mail Service (SMTP / Mailpit)
# ------------------------------------------------------------------------------
MAILPIT_WEB_BINDING=127.0.0.1:8025:8025
MAIL_PORT_BINDING=127.0.0.1:1025:1025

# ------------------------------------------------------------------------------
# 4. Security & Authentication (Spring Security / JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=pkampus_jwt_super_secret_key_development_min_32_characters_long_2026!
